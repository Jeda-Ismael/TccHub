{
	skip_install_trust

	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME:localhost} {
	log {
		{$CADDY_SERVER_LOG_OPTIONS}
	}

	root /app/public
	encode zstd br gzip

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	# API do Symfony (e as ferramentas de debug em dev)
	@api path /api /api/* /_profiler* /_wdt*
	rewrite @api /index.php

	# Frontend React: em produção o build fica em public/ e qualquer rota do
	# SPA (ex.: /coordination/users) cai no index.html. Em dev o frontend é
	# servido pelo Vite e este bloco não encontra o index.html (404).
	@spa {
		not path /index.php
		not file {path}
	}
	rewrite @spa /index.html

	@frontController path /index.php
	php @frontController {
		{$FRANKENPHP_SITE_CONFIG}

		worker {
			file ./public/index.php
			{$FRANKENPHP_WORKER_CONFIG}
		}
	}

	file_server {
		hide *.php
	}
}
