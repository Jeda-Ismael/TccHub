{% extends 'email/base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block content %}
    <p style="margin:0 0 12px;">Olá, {{ name }}.</p>
    <h1 style="margin:0 0 12px;font-size:19px;">{{ title }}</h1>
    {% if tccTitle %}
        <p style="margin:0 0 12px;color:#6b6b74;">TCC: <strong style="color:#18181b;">{{ tccTitle }}</strong></p>
    {% endif %}
    <p style="margin:0 0 20px;">{{ body }}</p>
    <p style="margin:0;">
        <a href="{{ link }}" style="display:inline-block;background:#ce0058;color:#ffffff;text-decoration:none;font-weight:bold;padding:10px 18px;border-radius:8px;">Abrir o hubtcc</a>
    </p>
{% endblock %}
