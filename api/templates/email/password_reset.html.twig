{% extends 'email/base.html.twig' %}

{% block title %}Troca de senha{% endblock %}

{% block content %}
    <p style="margin:0 0 12px;">Olá, {{ name }}.</p>
    <p style="margin:0 0 20px;">Recebemos um pedido para trocar a sua senha do hubtcc. Clique no botão para escolher uma nova. O link vale por 1 hora e só pode ser usado uma vez.</p>
    <p style="margin:0 0 20px;">
        <a href="{{ link }}" style="display:inline-block;background:#ce0058;color:#ffffff;text-decoration:none;font-weight:bold;padding:10px 18px;border-radius:8px;">Escolher nova senha</a>
    </p>
    <p style="margin:0;color:#6b6b74;font-size:13px;">Se não foi você, ignore este e-mail: a sua senha continua a mesma.</p>
{% endblock %}
