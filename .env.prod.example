# Copie para .env.prod no servidor e preencha. NUNCA versione o .env.prod.
# Gere valores aleatórios com: openssl rand -hex 32

# Domínio apontando para o servidor (registro DNS tipo A)
SERVER_NAME=tcc.suafaculdade.edu.br

APP_SECRET=troque-por-um-valor-aleatorio
JWT_PASSPHRASE=troque-por-outro-valor-aleatorio

POSTGRES_DB=hubtcc
POSTGRES_USER=app
POSTGRES_PASSWORD=troque-por-uma-senha-forte

# E-mails (avisos, lembrete de notas, "esqueci minha senha"). Sem isso, os e-mails são descartados.
# MAILER_DSN=smtp://usuario:senha@smtp-relay.brevo.com:587
